<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 🎬 Movie Watchlist</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light min-vh-100 d-flex flex-column">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 fs-4" asp-area="" asp-page="/Index">
                    <span class="badge bg-danger p-2"><i class="bi bi-film"></i></span>
                    <span>MovieWatchlist</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-light px-3" asp-area="" asp-page="/Index">
                                <i class="bi bi-collection-play me-1"></i> Watchlist
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-3" asp-area="" asp-page="/Movies/Add">
                                <i class="bi bi-plus-circle me-1"></i> Add Movie
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info px-3" asp-area="" asp-page="/Guide">
                                <i class="bi bi-git me-1"></i> GitHub Guide
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary px-3 py-2 rounded-pill">
                            <i class="bi bi-cpu me-1"></i> .NET 10 Ready
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-black border-top border-secondary text-secondary">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div class="col-md-4 d-flex align-items-center">
                <span>🎬 Movie Watchlist &mdash; Collaboration Sandbox for GitHub</span>
            </div>
            <ul class="nav col-md-4 justify-content-end list-unstyled d-flex gap-3">
                <li><a class="text-secondary text-decoration-none" asp-page="/Index"><i class="bi bi-house"></i> Home</a></li>
                <li><a class="text-secondary text-decoration-none" asp-page="/Guide"><i class="bi bi-book"></i> Git Tutorial</a></li>
            </ul>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
