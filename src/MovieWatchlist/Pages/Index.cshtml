@page
@model IndexModel
@{
    ViewData["Title"] = "My Watchlist";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@Model.StatusMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header & Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card bg-secondary bg-opacity-25 border-secondary h-100 shadow-sm">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-secondary text-uppercase small mb-1">Total Movies</h6>
                    <h2 class="fw-bold mb-0 text-white">@Model.Stats.TotalMovies</h2>
                </div>
                <div class="fs-1 text-primary"><i class="bi bi-film"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card bg-secondary bg-opacity-25 border-secondary h-100 shadow-sm">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-secondary text-uppercase small mb-1">To Watch</h6>
                    <h2 class="fw-bold mb-0 text-warning">@Model.Stats.UnwatchedCount</h2>
                </div>
                <div class="fs-1 text-warning"><i class="bi bi-clock-history"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card bg-secondary bg-opacity-25 border-secondary h-100 shadow-sm">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-secondary text-uppercase small mb-1">Watched</h6>
                    <h2 class="fw-bold mb-0 text-success">@Model.Stats.WatchedCount</h2>
                </div>
                <div class="fs-1 text-success"><i class="bi bi-check2-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card bg-secondary bg-opacity-25 border-secondary h-100 shadow-sm">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-secondary text-uppercase small mb-1">Avg Rating</h6>
                    <h2 class="fw-bold mb-0 text-info">@(Model.Stats.AverageRating > 0 ? $"{Model.Stats.AverageRating:0.0} ★" : "N/A")</h2>
                </div>
                <div class="fs-1 text-info"><i class="bi bi-star-half"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Controls / Filter Bar -->
<div class="card bg-black border-secondary p-3 mb-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-secondary border-secondary text-light"><i class="bi bi-search"></i></span>
                <input type="text" name="SearchTerm" class="form-control bg-dark text-light border-secondary" 
                       placeholder="Search title, director, notes..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="SelectedGenre" class="form-select bg-dark text-light border-secondary">
                <option value="">All Genres</option>
                @foreach (var genre in Model.AvailableGenres)
                {
                    <option value="@genre" selected="@(Model.SelectedGenre == genre ? "selected" : null)">@genre</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="StatusFilter" class="form-select bg-dark text-light border-secondary">
                <option value="">All Statuses</option>
                <option value="unwatched" selected="@(Model.StatusFilter == "unwatched" ? "selected" : null)">⏳ Want to Watch</option>
                <option value="watched" selected="@(Model.StatusFilter == "watched" ? "selected" : null)">✅ Watched</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-light flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-page="/Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Movie List -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-collection-play me-2"></i>Movies (@Model.Movies.Count)</h4>
    <a asp-page="/Movies/Add" class="btn btn-danger fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Add Movie
    </a>
</div>

@if (Model.Movies.Count == 0)
{
    <div class="text-center py-5 border border-dashed border-secondary rounded-3 bg-secondary bg-opacity-10 my-4">
        <div class="display-4 text-secondary mb-3"><i class="bi bi-camera-reels"></i></div>
        <h4 class="fw-bold">No movies found</h4>
        <p class="text-secondary">Try adjusting your filters or add a new movie to get started!</p>
        <a asp-page="/Movies/Add" class="btn btn-danger mt-2">
            <i class="bi bi-plus-circle me-1"></i> Add Your First Movie
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var movie in Model.Movies)
        {
            <div class="col">
                <div class="card h-100 bg-secondary bg-opacity-10 border-secondary shadow-sm hover-shadow transition">
                    <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-start pt-3">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary">
                            @movie.Genre
                        </span>
                        <span class="badge @(movie.IsWatched ? "bg-success" : "bg-warning text-dark")">
                            @(movie.IsWatched ? "Watched" : "To Watch")
                        </span>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-white mb-1">@movie.Title</h5>
                        <div class="text-secondary small mb-2">
                            <i class="bi bi-calendar3 me-1"></i> @movie.ReleaseYear
                            @if (!string.IsNullOrEmpty(movie.Director))
                            {
                                <span class="ms-2"><i class="bi bi-person me-1"></i> @movie.Director</span>
                            }
                        </div>

                        @if (movie.Rating.HasValue && movie.Rating.Value > 0)
                        {
                            <div class="mb-2 text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= movie.Rating.Value)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-secondary"></i>
                                    }
                                }
                                <span class="text-secondary small ms-1">(@movie.Rating.Value/5)</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(movie.Notes))
                        {
                            <p class="card-text text-light small bg-black bg-opacity-40 p-2 rounded border border-secondary border-opacity-50">
                                @movie.Notes
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-secondary d-flex justify-content-between align-items-center py-2">
                        <form method="post" asp-page-handler="ToggleWatched" asp-route-id="@movie.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm @(movie.IsWatched ? "btn-outline-warning" : "btn-outline-success")">
                                <i class="bi @(movie.IsWatched ? "bi-arrow-counterclockwise" : "bi-check2") me-1"></i>
                                @(movie.IsWatched ? "Mark Unwatched" : "Mark Watched")
                            </button>
                        </form>
                        <div class="btn-group btn-group-sm">
                            <a asp-page="/Movies/Edit" asp-route-id="@movie.Id" class="btn btn-outline-light" title="Edit movie">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@movie.Id" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this movie?');">
                                <button type="submit" class="btn btn-outline-danger" title="Delete movie">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
